# Copy this file to .env and fill in your credentials
# NEVER commit .env to git

# Tarjouspalvelu.fi login (optional — enables full tender details)
TARJOUSPALVELU_EMAIL=your-email@example.com
TARJOUSPALVELU_PASSWORD=your-password-here

# AI Model (default: gpt-4.1-nano for cheap dev runs, use gpt-4o-mini for production)
OPENAI_MODEL=gpt-4.1-nano

# SMTP for email notifications (optional — without this, emails are saved as HTML previews)
# For Gmail: use an App Password from https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=your-email@gmail.com

# Hilma API (free, register at https://hns-hilma-prod-apim.developer.azure-api.net/)
# Subscribe to AVP-Read product to get key
HILMA_API_KEY=your-hilma-api-key
