# Copy this file to .env and fill in your credentials
# NEVER commit .env to git

# Tarjouspalvelu.fi login (optional — enables full tender details)
TARJOUSPALVELU_EMAIL=your-email@example.com
TARJOUSPALVELU_PASSWORD=your-password-here

# AI Model (default: gpt-4.1-nano for cheap dev runs, use gpt-4o-mini for production)
OPENAI_MODEL=gpt-4.1-nano

# SMTP for email notifications (optional — without this, emails are saved as HTML previews)
# For Gmail: use an App Password from https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=your-email@gmail.com

# Hilma API (free, register at https://hns-hilma-prod-apim.developer.azure-api.net/)
# Subscribe to AVP-Read product to get key
HILMA_API_KEY=your-hilma-api-key

# -- Pilot / review controls ------------------------------------------------
# Reviewer-gate mode: during MVP pilot, all digest emails go to ONE reviewer
# mailbox instead of the real BU-leader addresses. The reviewer verifies
# routing (keywords + recipients) and forwards manually if correct.
# Leave REVIEWER_MODE unset (or =0) once pilot confirms routing quality.
REVIEWER_MODE=0
REVIEWER_EMAIL=reviewer@example.com

# AI metadata extraction: when enabled, runs an extra OpenAI call per
# detail-scraped tender to pull scoring (quality/price weights), contract-
# included flag, and reservations-allowed flag. Opt-in because it adds
# ~€0.001 per tender. See extract.py.
ENABLE_METADATA_EXTRACTION=0

# -- Graph API upload (personal OneDrive for PoC / SharePoint for prod) ----
# Default template below is for the PoC path: personal Microsoft account
# → personal OneDrive. See docs/sharepoint_setup.md for the 5-minute
# walkthrough and the production variant (CGI SharePoint).
#
# PoC — personal OneDrive (recommended during MVP):
#   GRAPH_TENANT_ID=consumers
#   GRAPH_CLIENT_ID=<app registered in your personal Microsoft account>
#   SHAREPOINT_SITE_HOST=     (leave blank)
#   SHAREPOINT_SITE_PATH=     (leave blank)
#
# Production — CGI SharePoint (Azure team sets this up, not the developer):
#   GRAPH_TENANT_ID=<cgi tenant GUID>
#   GRAPH_CLIENT_ID=<cgi app registration>
#   GRAPH_CLIENT_SECRET=<optional; switches to app-only auth>
#   SHAREPOINT_SITE_HOST=cgi.sharepoint.com
#   SHAREPOINT_SITE_PATH=/sites/TenderAgent

GRAPH_TENANT_ID=consumers
GRAPH_CLIENT_ID=00000000-0000-0000-0000-000000000000
# GRAPH_CLIENT_SECRET=

SHAREPOINT_SITE_HOST=
SHAREPOINT_SITE_PATH=
SHAREPOINT_FOLDER=Tender-Staging

# Gate for whether the scraper uploads ZIPs at all. Off by default until
# auth + target are set up.
ENABLE_SHAREPOINT_UPLOAD=0
