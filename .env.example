# =============================================================================
# Tender Intelligence — environment configuration
# =============================================================================
# Copy this file to .env and fill in what you need.
# The same code runs in demo and production; what differs is which env vars
# are set. See README "Demo vs production" section for the full mapping.
#
# NEVER commit .env to git.
# =============================================================================


# -----------------------------------------------------------------------------
# 1. SOURCE CREDENTIALS  (needed to actually fetch tender data)
# -----------------------------------------------------------------------------

# Hilma API (free public REST API for Finnish procurement notices).
# Register at https://hns-hilma-prod-apim.developer.azure-api.net/
# Subscribe to AVP-Read product to get key.
HILMA_API_KEY=

# tarjouspalvelu.fi login (optional but recommended — without these, the
# scraper can still see public listings but not detail tabs or ZIP attachments).
TARJOUSPALVELU_EMAIL=
TARJOUSPALVELU_PASSWORD=


# -----------------------------------------------------------------------------
# 2. AI PROVIDER  (pick ONE; system auto-selects based on what's set)
# -----------------------------------------------------------------------------

# OPTION A — OpenAI direct (demo / dev default)
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# OPTION B — Azure OpenAI Service / AI Foundry (production, in-tenant)
# If AZURE_OPENAI_ENDPOINT is set, code uses AzureOpenAI client instead.
# AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com/
# AZURE_OPENAI_API_VERSION=2024-08-01-preview
# AZURE_OPENAI_API_KEY=

# Model name (works for both providers).
# - OpenAI direct: pass the model ID, e.g. gpt-4.1-nano (cheap dev) or gpt-4o-mini (prod)
# - Azure OpenAI:  pass the *deployment name* you chose at deploy time
OPENAI_MODEL=gpt-4.1-nano


# -----------------------------------------------------------------------------
# 3. DATABASE  (defaults to local SQLite if not set)
# -----------------------------------------------------------------------------

# Demo / local: leave unset → SQLite at data/tenders.db
# Production:   set to a SQLAlchemy URL pointing at Azure SQL / Postgres / etc.
#
# Examples:
#   mssql+pyodbc://USER:PASS@server.database.windows.net,1433/dbname?driver=ODBC+Driver+18+for+SQL+Server
#   mssql+pyodbc://server.database.windows.net,1433/dbname?driver=ODBC+Driver+18+for+SQL+Server&Authentication=ActiveDirectoryMsi
# DATABASE_URL=


# -----------------------------------------------------------------------------
# 4. EMAIL  (SMTP — used when ENABLE_EMAIL=1; otherwise emails are saved as
#            HTML previews in data/previews/)
# -----------------------------------------------------------------------------

# For Gmail dev: use an App Password from https://myaccount.google.com/apppasswords
# For CGI prod: use M365 SMTP relay credentials, OR switch to Graph Mail.Send
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Reviewer-gate (pilot mode): all per-department digests redirect to ONE
# reviewer mailbox. Reviewer manually forwards to the actual team after
# verifying routing. Recommended during the 4-week pilot. Set to 0 at go-live.
REVIEWER_MODE=0
REVIEWER_EMAIL=


# -----------------------------------------------------------------------------
# 5. SHAREPOINT UPLOAD  (Graph API — only needed when ENABLE_SHAREPOINT_UPLOAD=1)
# -----------------------------------------------------------------------------

# Demo / personal OneDrive (PoC, fastest): see docs/sharepoint_setup.md
#   GRAPH_TENANT_ID=consumers
#   GRAPH_CLIENT_ID=<app registered against your personal Microsoft account>
#   SHAREPOINT_SITE_HOST=        (leave blank — routes to /me/drive)
#   SHAREPOINT_SITE_PATH=        (leave blank)
#
# Production / CGI SharePoint:
#   GRAPH_TENANT_ID=<CGI tenant GUID>
#   GRAPH_CLIENT_ID=<CGI app registration>
#   GRAPH_CLIENT_SECRET=<secret>             (presence enables app-only auth)
#   SHAREPOINT_SITE_HOST=cgi.sharepoint.com
#   SHAREPOINT_SITE_PATH=/sites/TenderAgent
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
# GRAPH_CLIENT_SECRET=
SHAREPOINT_SITE_HOST=
SHAREPOINT_SITE_PATH=
SHAREPOINT_FOLDER=Tender-Staging


# -----------------------------------------------------------------------------
# 6. FEATURE TOGGLES  (defaults are safe for demo)
# -----------------------------------------------------------------------------

# Real email send vs. write HTML preview to data/previews/
ENABLE_EMAIL=0

# AI summarisation per relevant tender (uses OPENAI_API_KEY or Azure OpenAI)
ENABLE_SUMMARIZATION=1

# Award analysis (winners, prices, competitors) for results-tenders
ENABLE_ANALYSIS=1

# Open detail page per priority tender to scrape 6 tabs (slow but rich)
ENABLE_DETAIL_SCRAPE=0

# Download ZIP attachments from tarjouspalvelu (requires login)
ENABLE_DOWNLOAD_ATTACHMENTS=0

# Extra OpenAI call per detail-scraped tender to extract scoring weights,
# contract-included flag, reservations-allowed flag. Adds ~€0.001/tender.
ENABLE_METADATA_EXTRACTION=0

# Upload downloaded ZIPs to OneDrive / SharePoint via Graph API.
# Requires the GRAPH_* and SHAREPOINT_* vars in section 5 above.
ENABLE_SHAREPOINT_UPLOAD=0


# -----------------------------------------------------------------------------
# 7. LIMITS & TUNING  (defaults are sensible for production)
# -----------------------------------------------------------------------------

# Hilma look-back window in days (production cron usually runs daily, so 1 is right)
HILMA_DAYS=1

# Caps to keep AI cost predictable
SUMMARIZE_COUNT=10
ANALYSIS_COUNT=20

# Max detail-scrape per run (0 = no cap, slowest); tune down for time budget
DETAIL_SCRAPE_COUNT=0

# Cap number of department digest emails (0 = no cap)
MAX_EMAILS=0


# -----------------------------------------------------------------------------
# 8. RUNTIME  (don't change unless you know why)
# -----------------------------------------------------------------------------

# Headless Chrome (always 1 in containers; 0 lets you watch the browser locally)
HEADLESS=1

# Pause for Enter key at key demo checkpoints (only effective when HEADLESS=0)
DEMO_PAUSE=0
